# URL base da API do Cofre. Nada no código deve ter uma URL fixa — tudo lê
# daqui via import.meta.env.VITE_API_URL (ver src/api/client.js).
VITE_API_URL=/api

# Em produção, aponte para a API publicada, por exemplo:
# Em produção também use /api. A Vercel encaminha para o Render por rewrite,
# mantendo o cookie como first-party no Safari.
# VITE_API_URL=/api
#
# Com ou sem barra final tanto faz — src/api/client.js normaliza a URL base
# antes de montar qualquer requisição, então "...onrender.com/" e
# "...onrender.com" produzem exatamente o mesmo resultado.
