# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Nível mínimo de log exibido (debug | info | warn | error)
LOG_LEVEL=info

# ── Frontend ──────────────────────────────────────────────────────────────
# Origins autorizadas a chamar a API (CORS), separadas por vírgula.
# Ex.: FRONTEND_URLS=http://localhost:5173,https://cofre-orcin.vercel.app
FRONTEND_URLS=http://localhost:5173

# ── Banco de dados ────────────────────────────────────────────────────────
# Caminho do arquivo SQLite local. Em produção, configure o Turso.
DATABASE_PATH=./src/database/cofre.db
# TURSO_DATABASE_URL=libsql://cofre-seuusuario.turso.io
# TURSO_AUTH_TOKEN=

# ── Autenticação Google OAuth ────────────────────────────────────────────
# Client ID/Secret do cliente Web no Google Cloud. Nunca versione valores reais.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
AUTH_ALLOWED_EMAILS=seu-email@gmail.com
# AUTH_LEGACY_OWNER_EMAIL=seu-email@gmail.com

# Segredo usado para assinar o cookie HTTP-only. Use pelo menos 32 caracteres.
# SESSION_SECRET=
SESSION_TTL_DAYS=90
SESSION_COOKIE_NAME=cofre_session

# ── Integração Google Sheets ──────────────────────────────────────────────
# Em produção use o callback da Vercel cadastrado no cliente OAuth.
GOOGLE_SHEETS_CALLBACK_URL=http://localhost:5173/api/integrations/google-sheets/callback

# Chave base64 de 32 bytes para criptografar refresh tokens.
# Gere com: openssl rand -base64 32
# Nunca coloque o valor real neste arquivo; configure-o somente no .env/Render.
# GOOGLE_TOKEN_ENCRYPTION_KEY=
