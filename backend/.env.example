# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Nível mínimo de log exibido (debug | info | warn | error)
LOG_LEVEL=info

# ── Frontend ──────────────────────────────────────────────────────────────
# Origins autorizadas a chamar a API (CORS), separadas por vírgula — sem
# espaço extra necessário, mas tolerado. Ex.: ambiente local + produção:
# FRONTEND_URLS=http://localhost:5173,https://cofre-orcin.vercel.app
#
# IMPORTANTE: o nome é FRONTEND_URLS, no plural — "FRONTEND_URL" (singular)
# ainda é aceito como fallback (com aviso no log), mas pode deixar de
# funcionar no futuro. Confirme o nome exato ao configurar no painel do
# Render.
FRONTEND_URLS=http://localhost:5173

# ── Banco de dados ────────────────────────────────────────────────────────
# Caminho do arquivo SQLite. Relativo à raiz do backend.
DATABASE_PATH=./src/database/cofre.db

# Em produção, o banco persistente fica no Turso. Nunca exponha o token no frontend.
# TURSO_DATABASE_URL=libsql://cofre-seuusuario.turso.io
# TURSO_AUTH_TOKEN=

# ── Autenticação Google OAuth ────────────────────────────────────────────
# Client ID/Secret gerados no Google Cloud Console para o login com Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
AUTH_ALLOWED_EMAILS=felipeflw11@gmail.com
AUTH_LEGACY_OWNER_EMAIL=felipeflw11@gmail.com

# Segredo usado para assinar o cookie de sessão (HTTP-only) do usuário
# autenticado. Gerar um valor aleatório longo antes de usar em produção.
# SESSION_SECRET=
SESSION_TTL_DAYS=90
SESSION_COOKIE_NAME=cofre_session

# ── Integração Google Sheets (etapa futura) ──────────────────────────────
# ID da planilha do Google Sheets que o Cofre irá sincronizar.
# GOOGLE_SHEETS_ID=
